# Copy to backend/.env, or put these in the shared repo-root .env that app.py and
# inference.py already read. backend/.env wins where both define a value.

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
# Raw password; the API URL-encodes it itself (DB_PASS_ENC is not needed)
DB_PASS=your_db_password
DB_NAME=ppes

# Signs session/OTP/reset tokens. Long random string; rotating it signs everyone out.
SECRET_KEY=change-me

# Public URL of the Next.js app, used in password-reset links
APP_BASE_URL=https://ppes-siil.solargroup.com

# false only for local http:// development
COOKIE_SECURE=true

SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
MAIL_SENDER_NAME=PPE Safety Portal

# Local development without SMTP: print OTPs and reset links to the API log
DEV_PRINT_EMAILS=false
