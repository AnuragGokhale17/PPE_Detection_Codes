# Shared by the API (backend/), the workers (inference.py, trainer.py, cooldown.py,
# camera_status_mail.py) and the legacy Flask portal. Copy to .env at the repo root.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
# Raw password (the v2 API and workers URL-encode it themselves)
DB_PASS=your_db_password
# Only the legacy Flask portal needs the URL-encoded copy
DB_PASS_ENC=your_db_encrypted_password
DB_NAME=ppes

# --- Object storage (MinIO) ---
BUCKET_NAME=mybucket
# What browsers and the evidence-image URLs use
S3_ENDPOINT_URL=https://your-s3-endpoint:9000
# What the API and workers connect to on the server
INTERNAL_S3_ENDPOINT_URL=https://127.0.0.1:9000
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_VERIFY_TLS=false
# Base of ppes.image_url written by inference.py
PUBLIC_IMAGE_BASE=https://ppes-siil.solargroup.com:9000
# Fallback when MinIO is unreachable (and the only store when no S3 keys are set)
# LOCAL_STORAGE_DIR=/home/administrator/PPEsDetection/var/storage

# --- Email (Office 365) ---
SENDER_EMAIL=your_email@example.com
SMTP_EMAIL=your_email@example.com
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
# Sender name on portal emails (OTP, password reset) and the relay app
MAIL_SENDER_NAME="IIoT Team"

# --- Web portal (API) ---
# Signs sessions, OTP challenges and reset links. Rotating it signs everyone out.
SECRET_KEY=your_secret_key_here
# Public URL of the portal, used in password-reset emails
APP_BASE_URL=https://ppes-siil.solargroup.com
# false only for local http:// development
COOKIE_SECURE=true

# --- inference.py ---
# CHECK_INTERVAL_SECONDS=60       # one frame per camera per interval
# EVENT_COOLDOWN_SECONDS=3600     # at most one event per production house + area
# CONFIG_POLL_SECONDS=30          # how quickly portal changes reach live detection
# PREDICT_CONF=0.25               # boxes stored for review; alerts still use per-class thresholds
# STARTUP_STAGGER_SECONDS=35

# --- trainer.py ---
# TRAINER_POLL_SECONDS=10
# TRAINER_PAUSE_WAIT_SECONDS=180  # wait for inference to release the GPU
# TRAINER_KEEP_DATASETS=false

# --- cooldown.py / camera_status_mail.py ---
# Set to True to send an email immediately for testing
TEST_MODE=False

############################################################
# Relay server (others/relay_app.py)
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=("IIoT Team", "your_email@example.com")
API_SECRET_KEY=your_api_secret_key
