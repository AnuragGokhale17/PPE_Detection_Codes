[Unit]
Description=PPE platform web (Next.js)
After=network.target ppe-api.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/home/administrator/PPEsDetection/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Build first with: API_ORIGIN=http://127.0.0.1:8001 npm run build
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
