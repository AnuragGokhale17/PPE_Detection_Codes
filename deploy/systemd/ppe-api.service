[Unit]
Description=PPE platform API (FastAPI)
After=network.target postgresql.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/home/administrator/PPEsDetection/backend
# Reads ../.env (shared) and backend/.env (overrides)
ExecStart=/home/administrator/PPEsDetection/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
